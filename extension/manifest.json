{
  "manifest_version": 3,
  "name": "DecisionAI - Google Meet Recorder",
  "version": "1.0.0",
  "description": "Record Google Meet calls with separate tab & microphone audio channels streamed over WebSocket.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*",
    "https://*/*",
    "http://*/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "DecisionAI Recorder",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pcm-processor.js"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
