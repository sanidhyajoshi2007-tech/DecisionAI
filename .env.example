# ──────────────────────────────────────────────
# DecisionAI — Environment Configuration
# Copy to .env and fill in real values
# ──────────────────────────────────────────────

# ── App ──
APP_NAME=DecisionAI
APP_ENV=development
DEBUG=true

# ── Server ──
HOST=127.0.0.1
PORT=8000

# ── Database (SQLite for now; swap to PostgreSQL later) ──
DATABASE_URL=sqlite+aiosqlite:///./decisionai.db

# ── Audio Storage ──
AUDIO_STORAGE_DIR=audio_storage
MAX_UPLOAD_SIZE_MB=500

# ── Transcription (STT) ──
# Options: faster_whisper, gemini, sarvam, deepgram
TRANSCRIPTION_PROVIDER=faster_whisper

# faster-whisper (local offline inference via CTranslate2)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default

# Gemini Audio Transcription (Google GenAI REST)
GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Sarvam AI (Indian multilingual & Hinglish)
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_MODE=codemix

# Deepgram (Nova-3 code-switching)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Domain Glossary / Vocabulary Hints (comma-separated terms/names)
TRANSCRIPTION_GLOSSARY=DecisionAI,Google Meet,Sanidhya

# ── Embeddings ──
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── Vector Store (ChromaDB) ──
CHROMA_PERSIST_DIR=chroma_data

# ── LLM (Gemini) ──
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── CORS (comma-separated origins) ──
CORS_ORIGINS=http://localhost:8000,chrome-extension://YOUR_EXTENSION_ID
