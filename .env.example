# ==============================================================================
# DecisionAI: Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# ==============================================================================

# Application Settings
APP_NAME=DecisionAI
APP_ENV=development
DEBUG=true

# Server Network Configuration
HOST=127.0.0.1
PORT=8000

# Security and Session Settings
SECRET_KEY=dev-secret-key-decisionai-super-safe-change-in-production
SESSION_COOKIE_NAME=decisionai_session
SESSION_COOKIE_MAX_AGE_DAYS=14
EXTENSION_TOKEN_EXPIRE_MINUTES=60

# Google OAuth 2.0 Authentication
# Generate at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Rate Limiting (In-memory token bucket requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Database Configuration (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///./decisionai.db

# Audio File Storage Settings
AUDIO_STORAGE_DIR=audio_storage
MAX_UPLOAD_SIZE_MB=500

# Speech-to-Text (STT) Provider Selection
# Options: faster_whisper, gemini, sarvam, deepgram
TRANSCRIPTION_PROVIDER=faster_whisper

# faster-whisper Configuration (Local CTranslate2 inference)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Google Gemini Audio Transcription and LLM Post-Processing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.8-flash

# Sarvam AI Configuration (Specialized Indian Multilingual and Hinglish STT)
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v4
SARVAM_MODE=codemix

# Deepgram Configuration (Nova-3 Speech Platform)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Domain Glossary and Vocabulary Keyterms (Comma-separated)
TRANSCRIPTION_GLOSSARY=DecisionAI, Google Meet, Standup, UPI, Aadhaar

# Multilingual Embeddings Configuration
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB Vector Store Persistence
CHROMA_PERSIST_DIR=chroma_data

# LLM Post-Processing Provider (gemini default)
LLM_PROVIDER=gemini

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:8000
